{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bimd.com/pipeline-fiscal/events/documento-extraido.payload.schema.json",
  "title": "ExtractionPayload",
  "description": "Payload de documento.extraido. Valores monetários e quantidades trafegam como string decimal com ponto, nunca float.",
  "type": "object",
  "additionalProperties": false,
  "required": ["documentKind", "fields", "items", "itemsConfidence", "ocrEngine", "llmModel", "tokens"],
  "properties": {
    "documentKind": { "enum": ["NF-e", "NFC-e", "NFS-e", "Recibo", "Cupom"] },
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cnpj", "issuer", "issueDate", "total"],
      "properties": {
        "cnpj": { "$ref": "#/$defs/field" },
        "issuer": { "$ref": "#/$defs/field" },
        "issueDate": {
          "allOf": [
            { "$ref": "#/$defs/field" },
            { "properties": { "value": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" } } }
          ]
        },
        "total": {
          "allOf": [
            { "$ref": "#/$defs/field" },
            { "properties": { "value": { "type": ["string", "null"], "pattern": "^[0-9]+\\.[0-9]{2}$" } } }
          ]
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "quantity", "unitPrice"],
        "properties": {
          "description": { "type": "string", "minLength": 1 },
          "quantity": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,3})?$" },
          "unitPrice": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$" }
        }
      }
    },
    "itemsConfidence": { "$ref": "#/$defs/confidence" },
    "ocrEngine": { "enum": ["paddleocr", "pdf_text"] },
    "llmModel": { "type": "string", "minLength": 1 },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "output"],
      "properties": {
        "input": { "type": "integer", "minimum": 0 },
        "output": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "confidence", "source"],
      "properties": {
        "value": {
          "type": ["string", "null"],
          "description": "null quando o campo não foi encontrado; a confiança é 0 nesse caso."
        },
        "confidence": { "$ref": "#/$defs/confidence" },
        "source": {
          "enum": ["qr_code", "pdf_text", "ocr", "llm"],
          "description": "qr_code: lido do QR Code da NFC-e. pdf_text: valor presente na camada de texto do PDF. ocr: valor presente no texto do OCR. llm: valor que o LLM devolveu e não aparece no texto de origem."
        }
      }
    }
  }
}
