KAFKA_BOOTSTRAP_SERVERS=localhost:9092
RABBITMQ_URL=amqp://guest:guest@localhost:5673

S3_ENDPOINT=http://localhost:9050
S3_REGION=us-east-1
S3_BUCKET=pipeline-fiscal
# Em produção, uma credencial só de leitura. No compose local, o usuário root do MinIO.
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# Chave da API do Google Gemini (https://aistudio.google.com/apikey). Nunca versionar.
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_SECONDS=30

OCR_LANG=pt

OTEL_SERVICE_NAME=fiscal-worker
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
