VITE_API_BASE_URL=/api/v1

# Simulação no navegador (modo mock, enquanto o backend não existe).
# Com o backend ligado, o limiar vem de REVIEW_CONFIDENCE_THRESHOLD no Spring Boot.
VITE_MOCK_THRESHOLD=0.85
VITE_MOCK_FAILURE_RATE=0.25

# Endpoint do simulador de mensageria que recebe o espelho dos eventos
VITE_MESSAGING_SIMULATOR_URL=ws://localhost:8090/events
